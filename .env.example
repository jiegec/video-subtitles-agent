# 视频所在目录（默认 <repo>/project）
# PROJECT_DIR=./project

# whisper.cpp 可执行文件与模型
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=./ggml-medium.bin
# WHISPER_LANG=zh
# WHISPER_THREADS=8
# WHISPER_PROMPT=以下是简体中文的语音内容。

# ffmpeg
# FFMPEG_BIN=ffmpeg

# LLM（任意 OpenAI 兼容接口）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash
# LLM_CONCURRENCY=4
# LLM_MAX_TOKENS=16384
# LLM_TIMEOUT=180
# LLM_THINKING=off   # off / low / medium / high / auto（推理型模型建议 off，避免思考占满输出）

# 字幕生成默认参数
# SUBTITLE_MAX_CHARS=18
# SUBTITLE_MIN_DURATION=0.8
# LLM_BLOCK_CHARS=220

# 视频截图（给多模态 LLM 提供画面上下文）
# FRAME_INTERVAL=45
# FRAME_MAX_PER_BATCH=4
# FRAME_MAX_COUNT=240

# 参考资料最多注入多少字（超出会自动摘要）
# CONTEXT_MAX_CHARS=12000

# 漏识别补齐：找出 whisper 漏掉/听错的内容并针对性重转
# RECOVER_MODEL=            # 可选：用更大的模型补转，默认同 WHISPER_MODEL
# RECOVER_NOISE_DB=-30      # silencedetect 噪声阈值
# RECOVER_MIN_SILENCE=0.4   # 超过多久算静音
# RECOVER_MIN_GAP=1.5       # 最短时间缺口（秒）
# RECOVER_MIN_CPS=1.8       # 语速下限（字/秒），低于则视为稀疏片段
# RECOVER_LOW_CONF_THRESHOLD=0.45
# RECOVER_MAX_REGIONS=80

# SRT 历史版本（自动保存时备份到 <视频名>.backups/）
# SRT_BACKUP_KEEP=100        # 最多保留多少个版本
# SRT_BACKUP_INTERVAL=120    # 自动保存时两次备份的最小间隔（秒）
