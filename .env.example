# 视频所在目录（默认 <repo>/project）
# PROJECT_DIR=./project

# whisper.cpp 可执行文件与模型
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=./ggml-medium.bin
# WHISPER_LANG=zh
# WHISPER_THREADS=8
# WHISPER_PROMPT=以下是简体中文的语音内容。

# ffmpeg
# FFMPEG_BIN=ffmpeg

# LLM（任意 OpenAI 兼容接口）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash
# LLM_CONCURRENCY=4
# LLM_MAX_TOKENS=16384
# LLM_TIMEOUT=180
# LLM_THINKING=off   # off / low / medium / high / auto（推理型模型建议 off，避免思考占满输出）

# 字幕生成默认参数
# SUBTITLE_MAX_CHARS=18
# SUBTITLE_MIN_DURATION=0.8
# LLM_BLOCK_CHARS=220

# 视频截图（给多模态 LLM 提供画面上下文）
# FRAME_INTERVAL=45
# FRAME_MAX_PER_BATCH=4
# FRAME_MAX_COUNT=240

# 参考资料最多注入多少字（超出会自动摘要）
# CONTEXT_MAX_CHARS=12000
